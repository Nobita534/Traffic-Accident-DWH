table 'All Measure'
	lineageTag: 5cc51e54-a9c6-437f-88bc-b4a9c756579f

	measure 'Adverse Surface Incident Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('public fct_traffic_accidents'),
			        'public dim_natural_condition'[roadway_surface_cond] <> "Dry"
			    ),
			    COUNTROWS('public fct_traffic_accidents'),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b41958a2-ce5f-4b01-99bb-99608c9dfbbb

	measure 'Fatal total' = SUM('public fct_traffic_accidents'[injuries_fatal])
		formatString: 0
		lineageTag: fdfe5d02-03ae-4b97-a37e-a73de04bd494

	measure 'Severe Rate' = DIVIDE(COUNTROWS(FILTER('public fct_traffic_accidents', 'public fct_traffic_accidents'[is_severe] = TRUE)), 'All Measure'[Total Accident])
		formatString: 0%;-0%;0%
		lineageTag: 186180c4-c63b-4e3c-8cbc-33a85e193567

	measure 'Severe Total' = CALCULATE(COUNTROWS('public fct_traffic_accidents'), 'public fct_traffic_accidents'[is_severe] = TRUE)
		lineageTag: 380eb691-4380-455f-84b5-7e7605562320

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Accident' = COUNT('public fct_traffic_accidents'[fact_id])
		formatString: 0
		lineageTag: 15bca1cb-f544-48ce-a160-b8792d338cfa

	measure 'Severe Environmental Impact' =
			
			CALCULATE(
			    COUNTROWS('public fct_traffic_accidents'),
			    'public fct_traffic_accidents'[is_severe] = TRUE,
			    'public dim_natural_condition'[weather_condition] <> "CLEAR"
			)
		lineageTag: 5e1a2ced-0e6c-4353-b9c6-aaee555508e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fatal Crash Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('public fct_traffic_accidents'),
			        'public fct_traffic_accidents'[crash_severity_weight] = 12
			    ),
			    [Total Accident],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: db02dda8-2754-4682-9e17-43e802c5df28

	measure 'Total Severity Weight' =
			SUM('public fct_traffic_accidents'[crash_severity_weight])
		formatString: 0
		lineageTag: 6236f094-75d6-4724-af46-d164b8488b14

	measure 'Clear-Weather Severe Accidents' =
			
			CALCULATE(
			    'All Measure'[Total Accident],
			    'public fct_traffic_accidents'[is_severe] = TRUE(),
			    'public dim_natural_condition'[weather_condition] = "CLEAR"
			)
		formatString: 0
		lineageTag: 3d6b560a-f55c-4234-bac9-74a08a030547

	measure 'Severity Index' =
			DIVIDE(
			    [Total Severity Weight],
			    [Total Accident],
			    0
			)
		lineageTag: b2fc08af-bc9f-4cb9-8f64-9223627d193b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Priority Trafficways' = ```
			
			VAR _ThresholdAccidents = 'All Measure'[Avg Accident] -- Ngưỡng X định biên tùy chọn
			VAR _ThresholdSeverity = 'All Measure'[Avg Severity Index according Trafficway_type]   -- Ngưỡng Y định biên tùy chọn
			VAR _SummaryTable = 
			    FILTER(
			        SUMMARIZE(
			            'public fct_traffic_accidents',
			            'public dim_traffic_device'[trafficway_type]
			        ),
			        'All Measure'[Total Accident] > _ThresholdAccidents && [Severity Index] > _ThresholdSeverity
			    )
			RETURN
			    COUNTROWS(_SummaryTable)
			```
		formatString: 0
		lineageTag: 7934271f-6311-4b6b-82aa-c57e21494923

	measure 'Human Error Ratio' =
			
			DIVIDE(
			    CALCULATE(
			        'All Measure'[Total Accident],
			        'public dim_cause'[cause_group] = "Human Factors"
			    ),
			    'All Measure'[Total Accident],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4ba95ffe-7778-4853-88da-96cdd1736a6f

	measure 'Most Accident-Prone Trafficway' =
			
			VAR T =
			    ADDCOLUMNS(
			        VALUES('public dim_traffic_device'[trafficway_type]),
			        "@Accident", [Total Accident]
			    )
			RETURN
			    MAXX(
			        TOPN(1, T, [@Accident], DESC),
			        'public dim_traffic_device'[trafficway_type]
			    )
		lineageTag: 47680f71-9cd7-4db0-94ce-712233677614

	measure 'Avg Accident' =
			
			// AVERAGEX(VALUES('public dim_traffic_device'[trafficway_type]), [Total Accident])
			DIVIDE(
			    [Total Accident],
			    DISTINCTCOUNT('public dim_traffic_device'[trafficway_type])
			)
		lineageTag: ab83d69d-a86a-4ad4-9e79-1d1aaa67343c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Severity Index according Trafficway_type' =
			
			AVERAGEX(
			    VALUES('public dim_traffic_device'[trafficway_type]),
			    [Severity Index]
			)
		lineageTag: 04560f72-ffff-428b-8bd7-64787bb191eb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Severe Rate Comparison' =
			
			VAR _Condition =
			    SELECTEDVALUE('Condition Comparison'[Condition])
			
			RETURN
			SWITCH(
			    _Condition,
			
			    "Normal Condition",
			        CALCULATE(
			            [Severe Rate],
			            FILTER(
			                'public dim_natural_condition',
			                'public dim_natural_condition'[weather_condition]
			                    IN { "CLEAR", "CLOUDY/OVERCAST" }
			                &&
			                'public dim_natural_condition'[lighting_condition]
			                    IN { "DAYLIGHT", "DARKNESS, LIGHTED ROAD" }
			            )
			        ),
			
			    "Bad Condition",
			        CALCULATE(
			            [Severe Rate],
			            FILTER(
			                'public dim_natural_condition',
			                'public dim_natural_condition'[weather_condition]
			                    IN {
			                        "RAIN",
			                        "SNOW",
			                        "BLOWING SNOW",
			                        "FREEZING RAIN/DRIZZLE",
			                        "FOG/SMOKE/HAZE",
			                        "SLEET/HAIL",
			                        "SEVERE CROSS WIND GATE",
			                        "BLOWING SAND, SOIL, DIRT"
			                    }
			                &&
			                'public dim_natural_condition'[lighting_condition]
			                    IN {"DARKNESS"}
			            )
			        )
			)
		lineageTag: 83b09750-e2b2-491e-bc50-88c18618b66e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Severe Condition' =
			
			VAR _P75 = [Accident Volume P75]
			VAR _ConditionTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident]),
			            "@SevereRate", CALCULATE([Severe Rate])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidConditions =
			    FILTER(
			        _ConditionTable,
			        NOT ISBLANK([@Accidents])
			            && [@Accidents] > 0
			            && NOT ISBLANK([@SevereRate])
			    )
			VAR _EligibleConditions =
			    FILTER(
			        _ValidConditions,
			        NOT ISBLANK(_P75)
			            && [@Accidents] >= _P75
			    )
			VAR _TopCondition =
			    TOPN(
			        1,
			        _EligibleConditions,
			        [@SevereRate], DESC,
			        [@Accidents], DESC,
			        'public dim_natural_condition'[weather_condition], ASC,
			        'public dim_natural_condition'[lighting_condition], ASC
			    )
			VAR _Result =
			    CONCATENATEX(
			        _TopCondition,
			        'public dim_natural_condition'[weather_condition]
			            & " / "
			            & 'public dim_natural_condition'[lighting_condition],
			        ", "
			    )
			RETURN
			    IF(ISBLANK(_Result) || _Result = "", "No Data", _Result)
		lineageTag: 7395fc6a-b864-4b32-8990-7a8a230d5c9e

	measure 'Accident Volume P25' =
			// Clear the hovered Weather × Lighting filters so the percentile
			// is calculated across the full condition population in the current slicer context.
			VAR _ConditionTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidConditions =
			    FILTER(
			        _ConditionTable,
			        NOT ISBLANK([@Accidents]) && [@Accidents] > 0
			    )
			RETURN
			    IF(
			        COUNTROWS(_ValidConditions) < 4,
			        BLANK(),
			        PERCENTILEX.INC(
			            _ValidConditions,
			            [@Accidents],
			            0.25
			        )
			    )
		formatString: 0
		lineageTag: e9ec9a76-27a4-4ef9-a390-61ad03495931

	measure 'Accident Volume P75' =
			// Clear the hovered Weather × Lighting filters so the percentile
			// is calculated across the full condition population in the current slicer context.
			VAR _ConditionTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidConditions =
			    FILTER(
			        _ConditionTable,
			        NOT ISBLANK([@Accidents]) && [@Accidents] > 0
			    )
			RETURN
			    IF(
			        COUNTROWS(_ValidConditions) < 4,
			        BLANK(),
			        PERCENTILEX.INC(
			            _ValidConditions,
			            [@Accidents],
			            0.75
			        )
			    )
		formatString: 0
		lineageTag: a9c6df4b-1d4f-4b88-a95c-f6b40cef9196

	measure 'Accident Volume Bucket' =
			VAR _Accidents = [Total Accident]
			VAR _P25 = [Accident Volume P25]
			VAR _P75 = [Accident Volume P75]
			VAR _IsConditionLevel =
			    HASONEVALUE('public dim_natural_condition'[weather_condition])
			        && HASONEVALUE('public dim_natural_condition'[lighting_condition])
			VAR _HasValidThresholds =
			    NOT ISBLANK(_P25)
			        && NOT ISBLANK(_P75)
			        && _P25 < _P75
			RETURN
			    IF(
			        NOT _IsConditionLevel
			            || ISBLANK(_Accidents)
			            || _Accidents <= 0
			            || NOT _HasValidThresholds,
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            _Accidents <= _P25, "Low Volume",
			            _Accidents < _P75, "Medium Volume",
			            "High Volume"
			        )
			    )
		lineageTag: 9c5aa8c7-792a-477d-821c-ff7684b56482

	measure 'Eligible Severe Condition' =
			IF(
			    [Accident Volume Bucket] IN { "Medium Volume", "High Volume" },
			    1,
			    0
			)
		formatString: 0
		lineageTag: 8e913af9-2bef-42f5-bbc0-0baf45523f3f

	measure 'Supported Severe Rate' =
			IF(
			    [Eligible Severe Condition] = 1,
			    [Severe Rate],
			    BLANK()
			)
		formatString: 0%;-0%;0%
		lineageTag: fe7546e7-aa72-4a01-8b39-ea8e043373ab

	measure 'Avg Units per Accident' =
			DIVIDE(
			    SUM('public fct_traffic_accidents'[num_units]),
			    [Total Accident],
			    0
			)
		formatString: 0.00
		lineageTag: 0907fd61-321b-4259-ab8b-cf85d06963fe

	measure 'Selected Natural Condition' =
			
			VAR _HasWeather =
			    HASONEVALUE(
			        'public dim_natural_condition'[weather_condition]
			    )
			
			VAR _HasLighting =
			    HASONEVALUE(
			        'public dim_natural_condition'[lighting_condition]
			    )
			
			RETURN
			    IF(
			        _HasWeather && _HasLighting,
			        SELECTEDVALUE(
			            'public dim_natural_condition'[weather_condition]
			        )
			            & " × "
			            & SELECTEDVALUE(
			                'public dim_natural_condition'[lighting_condition]
			            ),
			        "Hover one group natural condition"
			    )
		lineageTag: 49b82d0d-b0dd-488c-ae5f-23971e33b0ca

	measure 'Heatmap Volume Severity Color' =
			VAR _CurrentBucket = [Accident Volume Bucket]
			VAR _CurrentRate = [Severe Rate]
			VAR _P25 = [Accident Volume P25]
			VAR _P75 = [Accident Volume P75]
			VAR _IsConditionLevel =
			    HASONEVALUE('public dim_natural_condition'[weather_condition])
			        && HASONEVALUE('public dim_natural_condition'[lighting_condition])
			VAR _BaseTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident]),
			            "@SevereRate", CALCULATE([Severe Rate])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidTable =
			    FILTER(
			        _BaseTable,
			        NOT ISBLANK([@Accidents])
			            && [@Accidents] > 0
			            && NOT ISBLANK([@SevereRate])
			    )
			VAR _BucketedTable =
			    ADDCOLUMNS(
			        _ValidTable,
			        "@Bucket",
			            SWITCH(
			                TRUE(),
			                [@Accidents] <= _P25, "Low Volume",
			                [@Accidents] < _P75, "Medium Volume",
			                "High Volume"
			            )
			    )
			VAR _SameBucketTable =
			    FILTER(
			        _BucketedTable,
			        [@Bucket] = _CurrentBucket
			    )
			VAR _MinRate = MINX(_SameBucketTable, [@SevereRate])
			VAR _MaxRate = MAXX(_SameBucketTable, [@SevereRate])
			VAR _Intensity =
			    IF(
			        _MaxRate = _MinRate,
			        0.5,
			        DIVIDE(_CurrentRate - _MinRate, _MaxRate - _MinRate, 0.5)
			    )
			RETURN
			    IF(
			        NOT _IsConditionLevel
			            || ISBLANK(_CurrentBucket)
			            || ISBLANK(_CurrentRate)
			            || ISBLANK(_P25)
			            || ISBLANK(_P75),
			        "#1E293B",
			        SWITCH(
			            _CurrentBucket,
			            "Low Volume",
			                SWITCH(
			                    TRUE(),
			                    _Intensity <= 0.20, "#334155",
			                    _Intensity <= 0.40, "#475569",
			                    _Intensity <= 0.60, "#64748B",
			                    _Intensity <= 0.80, "#7C8DA3",
			                    "#94A3B8"
			                ),
			            "Medium Volume",
			                SWITCH(
			                    TRUE(),
			                    _Intensity <= 0.20, "#713F12",
			                    _Intensity <= 0.40, "#854D0E",
			                    _Intensity <= 0.60, "#A16207",
			                    _Intensity <= 0.80, "#CA8A04",
			                    "#F59E0B"
			                ),
			            "High Volume",
			                SWITCH(
			                    TRUE(),
			                    _Intensity <= 0.20, "#7F1D1D",
			                    _Intensity <= 0.40, "#991B1B",
			                    _Intensity <= 0.60, "#B91C1C",
			                    _Intensity <= 0.80, "#DC2626",
			                    "#EF4444"
			                ),
			            "#1E293B"
			        )
			    )
		lineageTag: 28c37d01-68f0-4ada-b54e-44fa459a8d9a

