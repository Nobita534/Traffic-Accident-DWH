	measure 'Adverse Low-Light Severe Rate' =
			CALCULATE(
			    [Severe Rate],
			    REMOVEFILTERS(
			        'public dim_natural_condition'[weather_condition],
			        'public dim_natural_condition'[lighting_condition]
			    ),
			    'public dim_natural_condition'[weather_condition]
			        IN {
			            "RAIN",
			            "SNOW",
			            "BLOWING SNOW",
			            "FREEZING RAIN/DRIZZLE",
			            "FOG/SMOKE/HAZE",
			            "SLEET/HAIL",
			            "SEVERE CROSS WIND GATE",
			            "BLOWING SAND, SOIL, DIRT"
			        },
			    'public dim_natural_condition'[lighting_condition] = "DARKNESS"
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 39c9900f-78b1-48ab-a355-c9851420aafd

	measure 'Total Injuries' = SUM('public fct_traffic_accidents'[injuries_total])
		formatString: 0
		lineageTag: 83f356f3-e9c8-490d-a702-e4dfac46a3d6

	measure 'Dominant Road Surface' =
			VAR _SurfaceTable =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(
			                'public dim_natural_condition'[roadway_surface_cond]
			            ),
			            "@Accidents", [Total Accident]
			        ),
			        NOT ISBLANK(
			            'public dim_natural_condition'[roadway_surface_cond]
			        )
			            && 'public dim_natural_condition'[roadway_surface_cond]
			                <> "UNKNOWN"
			            && [@Accidents] > 0
			    )
			RETURN
			    MAXX(
			        TOPN(
			            1,
			            _SurfaceTable,
			            [@Accidents], DESC,
			            'public dim_natural_condition'[roadway_surface_cond], ASC
			        ),
			        'public dim_natural_condition'[roadway_surface_cond]
			    )
		lineageTag: 1a4fd72c-5b2d-41e7-a8b3-b01d75d5099e

	measure 'Normal Condition Severe Rate' =
			CALCULATE(
			    [Severe Rate],
			    'public dim_natural_condition'[weather_condition]
			        IN { "CLEAR", "CLOUDY/OVERCAST" },
			    'public dim_natural_condition'[lighting_condition]
			        IN { "DAYLIGHT", "DARKNESS, LIGHTED ROAD" }
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 48029175-32fe-42e6-886a-2efc00c03b93

	measure 'Severe Rate Difference vs Normal pp' =
			VAR _AdverseRate = [Adverse Low-Light Severe Rate]
			VAR _NormalRate = [Normal Condition Severe Rate]
			RETURN
			    IF(
			        NOT ISBLANK(_AdverseRate)
			            && NOT ISBLANK(_NormalRate),
			        _AdverseRate - _NormalRate
			    )
		formatString: +0.00%;-0.00%;0.00%
		lineageTag: edfb3147-5afe-43cf-9e5c-22d7279169dd

	measure 'Priority Trafficway(s)' =
			VAR _ThresholdAccidents = [Avg Accident]
			VAR _ThresholdSeverity = [Avg Severity Index according Trafficway_type]
			VAR _Trafficways =
			    ADDCOLUMNS(
			        SUMMARIZE(
			            'public fct_traffic_accidents',
			            'public dim_traffic_device'[trafficway_type]
			        ),
			        "@Accidents", [Total Accident],
			        "@SeverityIndex", [Severity Index]
			    )
			VAR _PriorityTrafficways =
			    FILTER(
			        _Trafficways,
			        [@Accidents] > _ThresholdAccidents
			            && [@SeverityIndex] > _ThresholdSeverity
			    )
			VAR _Result =
			    CONCATENATEX(
			        _PriorityTrafficways,
			        'public dim_traffic_device'[trafficway_type],
			        ", ",
			        [@Accidents], DESC,
			        'public dim_traffic_device'[trafficway_type], ASC
			    )
			RETURN
			    IF(COUNTROWS(_PriorityTrafficways) = 0, "No Priority", _Result)
		lineageTag: 6dfc51c7-7213-46ce-b532-25c81bdf4e31

	measure 'Severe Favorable Human-Factor Crashes' =
			
			CALCULATE(
			    [Total Accident],
			
			    KEEPFILTERS(
			        'public fct_traffic_accidents'[is_severe] = TRUE()
			    ),
			
			    KEEPFILTERS(
			        'public dim_natural_condition'[condition_group] = "Favorable"
			    ),
			
			    KEEPFILTERS(
			        'public dim_cause'[cause_group] = "Human Factors"
			    )
			)
		formatString: 0
		lineageTag: 6171cee3-cbbf-4493-a513-ad3f0ca76e0f

	measure 'Severe Adverse Human-Factor Crashes' =
			CALCULATE(
			    [Total Accident],
			    KEEPFILTERS(
			        'public fct_traffic_accidents'[is_severe] = TRUE()
