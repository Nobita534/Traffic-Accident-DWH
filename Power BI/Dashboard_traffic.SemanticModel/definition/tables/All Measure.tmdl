	measure 'Severe Rate Comparison' =
			VAR _Condition =
			    SELECTEDVALUE('Condition Comparison'[Condition])
			RETURN
			    SWITCH(
			        _Condition,
			        "Normal Condition", [Normal Condition Severe Rate],
			        "Bad Condition", [Adverse Low-Light Severe Rate]
			    )
		lineageTag: 83b09750-e2b2-491e-bc50-88c18618b66e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Peak Severe Condition' =
			VAR _P75 = [Accident Volume P75]
			VAR _ConditionTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident]),
			            "@SevereRate", CALCULATE([Severe Rate])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidConditions =
			    FILTER(
			        _ConditionTable,
			        NOT ISBLANK([@Accidents])
			            && [@Accidents] > 0
			            && NOT ISBLANK([@SevereRate])
			    )
			VAR _EligibleConditions =
			    FILTER(
			        _ValidConditions,
			        NOT ISBLANK(_P75)
			            && [@Accidents] >= _P75
			    )
			VAR _TopCondition =
			    TOPN(
			        1,
			        _EligibleConditions,
			        [@SevereRate], DESC,
			        [@Accidents], DESC,
			        'public dim_natural_condition'[weather_condition], ASC,
			        'public dim_natural_condition'[lighting_condition], ASC
			    )
			VAR _Result =
			    CONCATENATEX(
			        _TopCondition,
			        'public dim_natural_condition'[weather_condition]
			            & " / "
			            & 'public dim_natural_condition'[lighting_condition],
			        ", "
			    )
			RETURN
			    IF(ISBLANK(_Result) || _Result = "", "No Data", _Result)
		lineageTag: 7395fc6a-b864-4b32-8990-7a8a230d5c9e

	measure 'Accident Volume P25' =
			VAR _ConditionTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidConditions =
			    FILTER(
			        _ConditionTable,
			        NOT ISBLANK([@Accidents]) && [@Accidents] > 0
			    )
			RETURN
			    IF(
			        COUNTROWS(_ValidConditions) < 4,
			        BLANK(),
			        PERCENTILEX.INC(
			            _ValidConditions,
			            [@Accidents],
			            0.25
			        )
			    )
		formatString: 0
		lineageTag: e9ec9a76-27a4-4ef9-a390-61ad03495931

	measure 'Accident Volume P75' =
			VAR _ConditionTable =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'public dim_natural_condition',
			            'public dim_natural_condition'[weather_condition],
			            'public dim_natural_condition'[lighting_condition],
			            "@Accidents", CALCULATE([Total Accident])
			        ),
			        REMOVEFILTERS('public dim_natural_condition'[weather_condition]),
			        REMOVEFILTERS('public dim_natural_condition'[lighting_condition])
			    )
			VAR _ValidConditions =
			    FILTER(
			        _ConditionTable,
			        NOT ISBLANK([@Accidents]) && [@Accidents] > 0
			    )
			RETURN
			    IF(
			        COUNTROWS(_ValidConditions) < 4,
			        BLANK(),
			        PERCENTILEX.INC(
			            _ValidConditions,
			            [@Accidents],
			            0.75
			        )
			    )
		formatString: 0
		lineageTag: a9c6df4b-1d4f-4b88-a95c-f6b40cef9196

	measure 'Accident Volume Bucket' =
			VAR _Accidents = [Total Accident]
			VAR _P25 = [Accident Volume P25]
			VAR _P75 = [Accident Volume P75]
			VAR _IsConditionLevel =
			    HASONEVALUE('public dim_natural_condition'[weather_condition])
			        && HASONEVALUE('public dim_natural_condition'[lighting_condition])
			VAR _HasValidThresholds =
			    NOT ISBLANK(_P25)
			        && NOT ISBLANK(_P75)
			        && _P25 < _P75
			RETURN
			    IF(
			        NOT _IsConditionLevel
			            || ISBLANK(_Accidents)
			            || _Accidents <= 0
			            || NOT _HasValidThresholds,
			        BLANK(),
			        SWITCH(
			            TRUE(),
			            _Accidents <= _P25, "Low Volume",
			            _Accidents < _P75, "Medium Volume",
			            "High Volume"
			        )
			    )
		lineageTag: 9c5aa8c7-792a-477d-821c-ff7684b56482

	measure 'Eligible Severe Condition' =
			IF(
			    [Accident Volume Bucket] IN { "Medium Volume", "High Volume" },
			    1,
			    0
			)
		formatString: 0
		lineageTag: 8e913af9-2bef-42f5-bbc0-0baf45523f3f

	measure 'Supported Severe Rate' =
			IF(
			    [Eligible Severe Condition] = 1,
			    [Severe Rate],
			    BLANK()
			)
		formatString: 0%;-0%;0%
		lineageTag: fe7546e7-aa72-4a01-8b39-ea8e043373ab

	measure 'Avg Units per Accident' =
			DIVIDE(
			    SUM('public fct_traffic_accidents'[num_units]),
